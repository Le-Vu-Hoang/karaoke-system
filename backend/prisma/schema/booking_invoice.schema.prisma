enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ARRIVED
}

enum InvoiceStatus {
  UNPAID
  PAID
}

model Booking {
  id               String        @id @default(uuid(7)) @db.Uuid
  customerId       String?       @db.Uuid
  guestName        String?
  guestPhone       String?
  roomTypeId       String        @db.Uuid
  roomId           String?       @db.Uuid
  bookingTime      DateTime
  durationExpected Int
  status           BookingStatus @default(PENDING)
  deposit          Decimal?      @default(0) @db.Decimal(10, 2)
  createdAt        DateTime      @default(now())

  customer User?     @relation("CustomerBookings", fields: [customerId], references: [id])
  roomType RoomType  @relation(fields: [roomTypeId], references: [id])
  room     Room?     @relation(fields: [roomId], references: [id])
  invoices Invoice[]
  payments Payment[]

  @@index([bookingTime])
  @@map("bookings")
}

model Invoice {
  id            String        @id @default(uuid(7)) @db.Uuid
  bookingId     String?       @db.Uuid
  roomId        String        @db.Uuid
  staffId       String        @db.Uuid
  startTime     DateTime      @default(now())
  endTime       DateTime?
  roomTotal     Decimal       @default(0) @db.Decimal(10, 2)
  servicesTotal Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  finalTotal    Decimal       @default(0) @db.Decimal(10, 2)
  status        InvoiceStatus @default(UNPAID)

  booking      Booking?         @relation(fields: [bookingId], references: [id])
  room         Room             @relation(fields: [roomId], references: [id])
  staff        User             @relation("StaffInvoices", fields: [staffId], references: [id])
  invoiceItems InvoiceService[]
  payments     Payment[]

  @@index([startTime, endTime])
  @@map("invoices")
}

model InvoiceService {
  id          String   @id @default(uuid(7)) @db.Uuid
  invoiceId   String   @db.Uuid
  serviceId   String   @db.Uuid
  quantity    Int
  priceAtTime Decimal  @db.Decimal(10, 2)
  orderTime   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@map("invoice_services")
}
