model User {
  fullName         String
  phoneNumber      String?         @unique
  email            String?         @unique
  passwordHash     String?
  role             Role            @default(CUSTOMER)
  provider         AuthProvider    @default(LOCAL)
  createdAt        DateTime        @default(now())
  id               String          @id @default(uuid(7)) @db.Uuid
  refreshToken     String?         @unique
  imageUrl         String?
  loyaltyPoints    Int             @default(0)
  totalSpent       Decimal         @default(0) @db.Decimal(10, 2)
  membershipTierId String?         @db.Uuid
  membershipTier   MembershipTier? @relation(fields: [membershipTierId], references: [id])
  bookings         Booking[]       @relation("CustomerBookings")
  invoices         Invoice[]       @relation("StaffInvoices")
  customerInvoices Invoice[]       @relation("CustomerInvoices")
  purchaseOrders   PurchaseOrder[] @relation("StaffPurchaseOrders")
  shifts           Shift[]         @relation("StaffShifts")
  userVouchers     UserVoucher[]

  @@index([phoneNumber])
  @@map("users")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}
