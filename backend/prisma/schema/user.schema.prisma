model User {
  fullName       String
  phoneNumber    String          @unique
  email          String?         @unique
  passwordHash   String
  role           Role            @default(CUSTOMER)
  createdAt      DateTime        @default(now())
  id             String          @id @default(uuid(7)) @db.Uuid
  refreshToken   String?         @unique
  imageUrl       String?
  bookings       Booking[]       @relation("CustomerBookings")
  invoices       Invoice[]       @relation("StaffInvoices")
  purchaseOrders PurchaseOrder[] @relation("StaffPurchaseOrders")
  shifts         Shift[]         @relation("StaffShifts")

  @@index([phoneNumber])
  @@map("users")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}
