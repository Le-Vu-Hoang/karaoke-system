enum EquipmentStatus {
  ACTIVE
  REPAIRING
  BROKEN
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id           String      @id @default(uuid(7)) @db.Uuid
  staffId      String      @db.Uuid
  startTime    DateTime    @default(now())
  endTime      DateTime?
  status       ShiftStatus @default(OPEN)
  startingCash Decimal     @db.Decimal(10, 2)
  endingCash   Decimal?    @db.Decimal(10, 2)
  expectedCash Decimal?    @db.Decimal(10, 2)

  staff User @relation("StaffShifts", fields: [staffId], references: [id])

  @@map("shifts")
}

model Equipment {
  id           String          @id @default(uuid(7)) @db.Uuid
  roomId       String          @db.Uuid
  name         String
  serialNumber String?         @unique
  status       EquipmentStatus @default(ACTIVE)

  room         Room             @relation(fields: [roomId], references: [id])
  maintenances MaintenanceLog[]

  @@map("equipments")
}

model MaintenanceLog {
  id              String   @id @default(uuid(7)) @db.Uuid
  equipmentId     String   @db.Uuid
  maintenanceDate DateTime @default(now())
  description     String   @db.Text
  cost            Decimal  @db.Decimal(10, 2)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@map("maintenance_logs")
}
