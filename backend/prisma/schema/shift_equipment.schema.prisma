model Shift {
  startTime    DateTime    @default(now())
  endTime      DateTime?
  startingCash Decimal     @db.Decimal(10, 2)
  endingCash   Decimal?    @db.Decimal(10, 2)
  expectedCash Decimal?    @db.Decimal(10, 2)
  id           String      @id @default(uuid(7)) @db.Uuid
  staffId      String      @db.Uuid
  status       ShiftStatus @default(OPEN)
  staff        User        @relation("StaffShifts", fields: [staffId], references: [id])

  @@map("shifts")
}

model Equipment {
  id           String           @id @default(uuid(7)) @db.Uuid
  name         String
  serialNumber String?          @unique
  status       EquipmentStatus  @default(ACTIVE)
  roomId       String           @db.Uuid
  room         Room             @relation(fields: [roomId], references: [id])
  maintenances MaintenanceLog[]

  @@map("equipments")
}

model MaintenanceLog {
  maintenanceDate DateTime  @default(now())
  description     String
  cost            Decimal   @db.Decimal(10, 2)
  id              String    @id @default(uuid(7)) @db.Uuid
  equipmentId     String    @db.Uuid
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@map("maintenance_logs")
}

enum EquipmentStatus {
  ACTIVE
  REPAIRING
  BROKEN
}
