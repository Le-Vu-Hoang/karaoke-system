# ==============================================
# K-Master Production Environment Variables
# ==============================================
# Copy this file to .env.production and fill in real values
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# ==============================================

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=ktv_production_db

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_PORT=6379

# ---- Backend (NestJS) ----
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_password@postgres:5432/ktv_production_db?schema=public
PORT=3001
NODE_ENV=production

# JWT
JWT_SECRET_KEY=CHANGE_ME_random_64_char_string
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=CHANGE_ME_another_random_64_char_string

# Redis (backend connection)
REDIS_HOST=redis

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# VNPay
VNPAY_TERMINAL_ID=
VNPAY_SECRET_KEY=
VNPAY_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_API=https://merchant.vnpay.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://your-domain.com/booking/success

# MoMo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://your-domain.com/booking/success
MOMO_IPN_URL=https://your-domain.com/api/v1/payment/momo/ipn

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.com/api/v1/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://your-domain.com/api/v1/auth/facebook/callback

# ---- Customer Frontend (build-time) ----
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_BACKEND_URL=https://your-domain.com/api/v1

# ---- Manager Frontend (build-time) ----
NEXT_PUBLIC_MANAGER_BACKEND_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_APP_NAME=K-Master Staff Portal
