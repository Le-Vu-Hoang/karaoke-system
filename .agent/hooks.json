{
  "lint-on-file-edit": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/lint-check.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
